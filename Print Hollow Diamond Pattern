import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int T=sc.nextInt();
        for(int k=1;k<=T;k++){
            int n=sc.nextInt();
            int mid=n/2;
            System.out.println("Case #"+k+":");
            for(int i=0;i<=mid;i++){
                for(int j=0;j<mid-i;j++){
                    System.out.print(" ");
                }
                for(int j=0;j<2*i+1;j++){
                    if(j==0||j==2*i){
                       System.out.print("*");
                    }else{
                        System.out.print(" ");
                    }
                }
                System.out.println();
            }
            for(int i=mid-1;i>=0;i--){
                for(int j=0;j<mid-i;j++){
                    System.out.print(" ");
                }
                for(int j=0;j<2*i+1;j++){
                    if(j==0||j==2*i){
                    System.out.print("*");
                    }else{
                        System.out.print(" ");
                    }
                }
                System.out.println();
            }
        }
    }
}
